# Copy this file to .env beside config.yaml. load_config("config.yaml") loads it
# automatically without replacing values already set by the shell, CI, or deployment.
# Provider values are required when strict mode is enabled. LangSmith values are
# additionally required whenever LANGSMITH_TRACING=true.

# Required for the default DeepSeek chat provider
DEEPSEEK_API_KEY=

# Optional: required only when provider or embedding_provider is 'openai'
OPENAI_API_KEY=

# Optional chat and embedding configuration overrides (values shown are the config.yaml defaults)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_THINKING_MODE=enabled
LLM_REASONING_EFFORT=high
LLM_EMBEDDING_PROVIDER=local
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT=1800.0
LLM_RETRY_COUNT=5

# Optional per-call reasoning effort (low, high or max for DeepSeek). Leave a
# line commented out to keep that call at its agent's profile effort: an empty
# value is rejected, not read as unset. See agents.operation_efforts in config.yaml.
# AGENTS_EFFORT_PAGE_EXTRACTION=
# AGENTS_EFFORT_OWED_EXTRACTION=
# AGENTS_EFFORT_CROSS_TOPIC_EXTRACTION=
# AGENTS_EFFORT_DISSENT_EXTRACTION=
# AGENTS_EFFORT_EXTRACTION=
# AGENTS_EFFORT_CONTEXT_CHECK=
# AGENTS_EFFORT_STATEMENT_CHECK=
# AGENTS_EFFORT_SOURCE_SCORING=
# AGENTS_EFFORT_PLAN_DRAFT=
# AGENTS_EFFORT_PLAN_REPAIR=
# AGENTS_EFFORT_PLAN_REVIEW=
# AGENTS_EFFORT_PLAN_REVIEW_REPAIR=
# AGENTS_EFFORT_PLAN_CONFIRMING_REVIEW=
# AGENTS_EFFORT_REACT_DECISION=

# Optional: true enables LangSmith emission; false keeps local events/metrics only.
LANGSMITH_TRACING=false

# Required only when LANGSMITH_TRACING=true.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Required: Tavily API key for web search
TAVILY_API_KEY=
