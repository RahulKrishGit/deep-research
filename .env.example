# Copy this file to .env beside config.yaml. load_config("config.yaml") loads it
# automatically without replacing values already set by the shell, CI, or deployment.
# Provider values are required when strict mode is enabled. LangSmith values are
# additionally required whenever LANGSMITH_TRACING=true.

# Required: OpenAI API key for LLM provider
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT=60.0
LLM_RETRY_COUNT=2

# Optional: true enables LangSmith emission; false keeps local events/metrics only.
LANGSMITH_TRACING=false

# Required only when LANGSMITH_TRACING=true.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Required: Tavily API key for web search
TAVILY_API_KEY=